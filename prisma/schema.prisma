generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  forms        Form[]
  dashboards   Dashboard[]
  formFolders   FormFolder[]
  formRevisions FormRevision[]
}

model FormFolder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin?   @relation(fields: [createdBy], references: [id])
  forms     Form[]

  @@unique([createdBy, name])
  @@map("form_folder")
}

model Form {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  closingMessage  String?          @map("closing_message")
  pausedMessage   String?          @map("paused_message")
  folderId        String?          @map("folder_id") @db.Uuid
  isTemplate      Boolean          @default(false) @map("is_template")
  status          String           @default("draft")
  version         Int              @default(1)
  slug            String?          @unique
  allowAnonymous  Boolean          @default(false) @map("allow_anonymous")
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  admin           Admin?           @relation(fields: [createdBy], references: [id])
  folderRef       FormFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  questions       Question[]
  responses       Response[]
  formRevisions   FormRevision[]
  dashboardCharts DashboardChart[]
}

model FormRevision {
  id         String   @id @default(uuid()) @db.Uuid
  formId     String   @map("form_id") @db.Uuid
  version    Int
  editedById String?  @map("edited_by") @db.Uuid
  summary    String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  editedBy   Admin?   @relation(fields: [editedById], references: [id])

  @@index([formId, createdAt(sort: Desc)])
  @@map("form_revision")
}

model Question {
  id                  String           @id @default(uuid()) @db.Uuid
  formId              String           @map("form_id") @db.Uuid
  type                String
  text                String
  required            Boolean          @default(false)
  orderIndex          Int              @default(0) @map("order_index")
  options             Json?
  scaleMin            Int?             @map("scale_min")
  scaleMax            Int?             @map("scale_max")
  conditionQuestionId String?          @map("condition_question_id") @db.Uuid
  conditionOperator   String?          @map("condition_operator")
  conditionValue      Json?            @map("condition_value")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  form                Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers             Answer[]
  dashboardCharts     DashboardChart[]

  @@index([formId, orderIndex])
  @@map("form_question")
}

model Respondent {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String
  employeeId String?  @map("employee_id")
  department String?
  createdAt  DateTime @default(now()) @map("created_at")
  responses  Response[]
}

model Response {
  id           String   @id @default(uuid()) @db.Uuid
  formId       String   @map("form_id") @db.Uuid
  respondentId String   @map("respondent_id") @db.Uuid
  submittedAt  DateTime @default(now()) @map("submitted_at")
  form         Form     @relation(fields: [formId], references: [id])
  respondent   Respondent @relation(fields: [respondentId], references: [id])
  answers      Answer[]
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  value      Json
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
}

model Dashboard {
  id        String           @id @default(uuid()) @db.Uuid
  title     String
  createdBy String?          @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  formIds   Json             @default("[]") @map("form_ids")
  admin     Admin?           @relation(fields: [createdBy], references: [id])
  charts    DashboardChart[]
}

model AiContextChunk {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  userId     String?  @map("user_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
}

model AppSqlMigration {
  filename  String   @id
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("_app_sql_migrations")
}

// ========== Módulo Financeiro (isolado do restante do sistema) ==========

model FinanceCashbox {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  transactionsOut Transaction[] @relation("CashboxOrigin")
  transactionsIn  Transaction[] @relation("CashboxDestination")
  payables    FinancePayable[]
  receivables FinanceReceivable[]

  @@map("finance_cashbox")
}

model FinanceCategory {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  type       String   // "entry" | "exit"
  parentId   String?  @map("parent_id") @db.Uuid
  parent     FinanceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   FinanceCategory[] @relation("CategoryHierarchy")
  transactions Transaction[]
  payables   FinancePayable[]
  receivables FinanceReceivable[]

  @@map("finance_category")
}

model FinancePaymentMethod {
  id   String @id @default(uuid()) @db.Uuid
  name String
  transactions Transaction[]
  payables   FinancePayable[]
  receivables FinanceReceivable[]

  @@map("finance_payment_method")
}

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  type            String   // "entry" | "exit" | "transfer" | "withdraw" | "supply"
  amount          Decimal  @db.Decimal(15, 2)
  description     String?
  categoryId      String?  @map("category_id") @db.Uuid
  category        FinanceCategory? @relation(fields: [categoryId], references: [id])
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  paymentMethod   FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  cashboxOriginId String?  @map("cashbox_origin_id") @db.Uuid
  cashboxOrigin   FinanceCashbox? @relation("CashboxOrigin", fields: [cashboxOriginId], references: [id])
  cashboxDestId   String?  @map("cashbox_dest_id") @db.Uuid
  cashboxDest     FinanceCashbox? @relation("CashboxDestination", fields: [cashboxDestId], references: [id])
  userId          String?  @map("user_id")
  movementAt      DateTime @default(now()) @map("movement_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  payablesPaid    FinancePayable[]  @relation("PayableTransaction")
  receivablesPaid FinanceReceivable[] @relation("ReceivableTransaction")

  @@map("transaction")
}

model FinancePayable {
  id              String    @id @default(uuid()) @db.Uuid
  description     String
  amount          Decimal   @db.Decimal(15, 2)
  dueDate         DateTime  @map("due_date") @db.Date
  status          String    @default("pending") // pending | paid | cancelled
  paidAt          DateTime? @map("paid_at")
  transactionId   String?   @map("transaction_id") @db.Uuid
  transaction     Transaction? @relation("PayableTransaction", fields: [transactionId], references: [id])
  cashboxId       String?   @map("cashbox_id") @db.Uuid
  cashbox         FinanceCashbox? @relation(fields: [cashboxId], references: [id])
  categoryId      String?   @map("category_id") @db.Uuid
  category        FinanceCategory? @relation(fields: [categoryId], references: [id])
  paymentMethodId String?   @map("payment_method_id") @db.Uuid
  paymentMethod   FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("finance_payable")
}

model FinanceReceivable {
  id              String    @id @default(uuid()) @db.Uuid
  description     String
  amount          Decimal   @db.Decimal(15, 2)
  dueDate         DateTime  @map("due_date") @db.Date
  status          String    @default("pending") // pending | received | cancelled
  receivedAt      DateTime? @map("received_at")
  transactionId   String?   @map("transaction_id") @db.Uuid
  transaction     Transaction? @relation("ReceivableTransaction", fields: [transactionId], references: [id])
  cashboxId       String?   @map("cashbox_id") @db.Uuid
  cashbox         FinanceCashbox? @relation(fields: [cashboxId], references: [id])
  categoryId      String?   @map("category_id") @db.Uuid
  category        FinanceCategory? @relation(fields: [categoryId], references: [id])
  paymentMethodId String?   @map("payment_method_id") @db.Uuid
  paymentMethod   FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  contractId      String?   @map("contract_id") @db.Uuid
  contract        FinanceContract? @relation(fields: [contractId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("finance_receivable")
}

model FinanceContract {
  id             String    @id @default(uuid()) @db.Uuid
  contractNumber String    @unique @map("contract_number")
  clientName     String?   @map("client_name")
  totalValue     Decimal   @db.Decimal(15, 2) @map("total_value")
  startDate      DateTime  @db.Date @map("start_date")
  endDate        DateTime? @db.Date @map("end_date")
  status         String    @default("active") // active | completed | cancelled
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  receivables    FinanceReceivable[]

  @@map("finance_contract")
}

model FinanceRevenueGoal {
  id          String   @id @default(uuid()) @db.Uuid
  year        Int
  month       Int
  goalValue   Decimal  @db.Decimal(15, 2) @map("goal_value")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("finance_revenue_goal")
}

model FinanceOperationalCost {
  id            String   @id @default(uuid()) @db.Uuid
  year          Int
  month         Int
  predictedCost Decimal  @db.Decimal(15, 2) @map("predicted_cost")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("finance_operational_cost")
}

model FinanceEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  eventDate   DateTime                @db.Date @map("event_date")
  status      String                  @default("planning") // planning | approved | in_progress | completed | cancelled
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  scenarios   FinanceEventScenario[]

  @@map("finance_event")
}

model FinanceEventScenario {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  event         FinanceEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scenarioName  String        @map("scenario_name")
  membersCount  Int           @map("members_count")
  costPerMember Decimal       @db.Decimal(15, 2) @map("cost_per_member")
  totalCost     Decimal       @db.Decimal(15, 2) @map("total_cost")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("finance_event_scenario")
}

model DashboardChart {
  id           String    @id @default(uuid()) @db.Uuid
  dashboardId  String    @map("dashboard_id") @db.Uuid
  formId       String    @map("form_id") @db.Uuid
  questionId   String    @map("question_id") @db.Uuid
  chartType    String    @map("chart_type") // bar | line | pie
  title        String
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  form         Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("dashboard_chart")
}
